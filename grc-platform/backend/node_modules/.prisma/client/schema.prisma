generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATIONS & DOMAINS (Context Module)
// ============================================

model Organization {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String         @default("")
  parentId    String?
  parent      Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgHierarchy")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  domains     Domain[]
  users       User[]
}

model Domain {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String        @default("")
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  parentId     String?
  parent       Domain?       @relation("DomainHierarchy", fields: [parentId], references: [id])
  children     Domain[]      @relation("DomainHierarchy")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  risks        Risk[]
  controls     Control[]
  assets       Asset[]
}

// ============================================
// IDENTITY & ACCESS MANAGEMENT
// ============================================

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String           @unique
  fullName        String
  passwordHash    String
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  orgId           String?
  organization    Organization?    @relation(fields: [orgId], references: [id])
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  isActive        Boolean          @default(true)
  mfaEnabled      Boolean          @default(false)
  mfaSecret       String?
  failedLogins    Int              @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userPermissions UserPermission[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String           @default("")
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String           @default("")
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  scope        String     @default("all")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  scope        String     @default("all")
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  token      String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String    @default("")
  createdAt  DateTime  @default(now())
}

// ============================================
// MASTER / REFERENCE DATA
// ============================================

model SeverityLevel {
  id    String @id @default(cuid())
  code  String @unique
  label String
  order Int
  color String @default("#7d7d86")
  risks Risk[]
}

model RiskScoreMethod {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String  @default("")
  isActive    Boolean @default(true)
  risks       Risk[]
}

model ControlType {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String    @default("")
  controls    Control[]
}

model DataClassification {
  id          String     @id @default(uuid())
  code        String     @unique
  label       String
  level       Int
  description String     @default("")
  policies    Policy[]
  evidence    Evidence[]
}

model PriorityLevel {
  id    String @id @default(uuid())
  code  String @unique
  label String
  order Int
  color String @default("#7d7d86")
}

model Department {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  risks      Risk[]
  audits     Audit[]
  auditPlans AuditPlan[]
  users      User[]
}

model AssessmentType {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String       @default("")
  assessments Assessment[]
}

model Framework {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  type              String             @default("Standard")
  version           String             @default("")
  issuer            String             @default("")
  description       String             @default("")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  requirements      Requirement[]
  controlFrameworks ControlFramework[]
  gaps              Gap[]
}

// ============================================
// RISK MANAGEMENT
// ============================================

model Risk {
  id                String            @id @default(cuid())
  riskCode          String            @unique
  title             String
  description       String            @default("")
  category          String            @default("")
  domainId          String?
  domain            Domain?           @relation(fields: [domainId], references: [id])
  orgId             String?
  ownerId           String
  departmentId      String?
  department        Department?       @relation(fields: [departmentId], references: [id])
  inherentScore     Int               @default(0)
  likelihood        Int               @default(1)
  impact            Int               @default(1)
  residualScore     Int               @default(0)
  riskScoreMethodId String?
  riskScoreMethod   RiskScoreMethod?  @relation(fields: [riskScoreMethodId], references: [id])
  severityId        String?
  severity          SeverityLevel?    @relation(fields: [severityId], references: [id])
  priority          String            @default("Medium")
  status            String            @default("Active")
  appetiteBreached  Boolean           @default(false)
  toleranceBreached Boolean           @default(false)
  identifiedDate    DateTime          @default(now())
  lastAssessedAt    DateTime?
  nextReviewDate    DateTime?
  targetCloseDate   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  controlLinks      RiskControlLink[]
  findings          Finding[]
  notifications     Notification[]
  evidence          Evidence[]
  gaps              Gap[]
}

model RiskControlLink {
  id            String   @id @default(cuid())
  riskId        String
  risk          Risk     @relation(fields: [riskId], references: [id])
  controlId     String
  control       Control  @relation(fields: [controlId], references: [id])
  linkType      String   @default("mitigates")
  effectiveness Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([riskId, controlId])
}

// ============================================
// CONTROLS
// ============================================

model Control {
  id                   String               @id @default(cuid())
  controlCode          String               @unique
  name                 String
  description          String               @default("")
  controlTypeId        String?
  controlType          ControlType?         @relation(fields: [controlTypeId], references: [id])
  domainId             String?
  domain               Domain?              @relation(fields: [domainId], references: [id])
  implementationStatus String               @default("Planned")
  effectiveness        Int                  @default(0)
  testStatus           String               @default("NotTested")
  lastTestDate         DateTime?
  nextTestDate         DateTime?
  ownerId              String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  riskLinks            RiskControlLink[]
  evidence             Evidence[]
  controlFrameworks    ControlFramework[]
  requirementControls  RequirementControl[]
}

model ControlFramework {
  controlId   String
  frameworkId String
  control     Control   @relation(fields: [controlId], references: [id])
  framework   Framework @relation(fields: [frameworkId], references: [id])

  @@id([controlId, frameworkId])
}

// ============================================
// POLICIES (Governance)
// ============================================

model Policy {
  id                 String              @id @default(cuid())
  policyCode         String              @unique
  title              String
  description        String              @default("")
  category           String              @default("")
  classification     String              @default("Internal")
  classificationId   String?
  dataClassification DataClassification? @relation(fields: [classificationId], references: [id])
  status             String              @default("Draft")
  version            String              @default("1.0")
  ownerId            String
  ownerUserId        String?
  effectiveDate      DateTime?
  expirationDate     DateTime?
  lastReviewDate     DateTime?
  nextReviewDate     DateTime?
  reviewPeriodDays   Int                 @default(365)
  createdByUserId    String?
  approvedByUserId   String?
  publishedByUserId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  versions           PolicyVersion[]
  exceptions         PolicyException[]
}

model PolicyVersion {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id])
  version    String
  content    String   @default("")
  changeType String   @default("Minor")
  summary    String   @default("")
  createdBy  String
  createdAt  DateTime @default(now())

  @@unique([policyId, version])
}

model PolicyException {
  id                   String    @id @default(cuid())
  policyId             String
  policy               Policy    @relation(fields: [policyId], references: [id])
  title                String
  description          String    @default("")
  reason               String    @default("")
  requestedBy          String
  approvedBy           String?
  status               String    @default("Requested")
  startDate            DateTime?
  expirationDate       DateTime?
  compensatingControls String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ============================================
// COMPLIANCE
// ============================================

model Requirement {
  id                  String               @id @default(cuid())
  code                String               @unique
  title               String
  description         String               @default("")
  frameworkId         String
  framework           Framework            @relation(fields: [frameworkId], references: [id])
  category            String               @default("")
  applicability       String               @default("Applicable")
  status              String               @default("NotAssessed")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assessments         Assessment[]
  evidence            Evidence[]
  requirementControls RequirementControl[]
  gaps                Gap[]
}

model RequirementControl {
  requirementId String
  controlId     String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  control       Control     @relation(fields: [controlId], references: [id])

  @@id([requirementId, controlId])
}

model Assessment {
  id                   String          @id @default(cuid())
  requirementId        String
  requirement          Requirement     @relation(fields: [requirementId], references: [id])
  assessmentTypeId     String?
  assessmentType       AssessmentType? @relation(fields: [assessmentTypeId], references: [id])
  status               String          @default("NotAssessed")
  assessor             String
  date                 DateTime        @default(now())
  comments             String          @default("")
  findings             String          @default("")
  controlEffectiveness String          @default("NotAssessed")
  reviewer             String          @default("")
  reviewStatus         String          @default("PendingReview")
  createdAt            DateTime        @default(now())

  @@unique([requirementId, date])
}

// ============================================
// EVIDENCE (Cross-module core entity)
// ============================================

model Evidence {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  description        String              @default("")
  type               String              @default("Document")
  owner              String
  uploadDate         DateTime            @default(now())
  effectiveDate      DateTime?
  expirationDate     DateTime?
  status             String              @default("Missing")
  verificationStatus String              @default("Pending")
  reviewer           String              @default("")
  comments           String              @default("")
  classification     String              @default("Internal")
  classificationId   String?
  dataClassification DataClassification? @relation(fields: [classificationId], references: [id])
  integrityHash      String              @default("")
  version            String              @default("1.0")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  requirementId      String?
  requirement        Requirement?        @relation(fields: [requirementId], references: [id])
  controlId          String?
  control            Control?            @relation(fields: [controlId], references: [id])
  findingId          String?
  finding            Finding?            @relation(fields: [findingId], references: [id])
  riskId             String?
  risk               Risk?               @relation(fields: [riskId], references: [id])
}

// ============================================
// COMPLIANCE GAP & REMEDIATION
// ============================================

model Gap {
  id            String        @id @default(cuid())
  code          String        @unique
  title         String
  description   String        @default("")
  currentState  String        @default("")
  expectedState String        @default("")
  severity      String        @default("Medium")
  priority      String        @default("Medium")
  status        String        @default("Open")
  owner         String
  dueDate       DateTime?
  closureDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  requirementId String?
  requirement   Requirement?  @relation(fields: [requirementId], references: [id])
  frameworkId   String?
  framework     Framework?    @relation(fields: [frameworkId], references: [id])
  riskId        String?
  risk          Risk?         @relation(fields: [riskId], references: [id])
  remediations  Remediation[]
}

model Remediation {
  id               String    @id @default(cuid())
  code             String    @unique
  title            String
  description      String    @default("")
  action           String    @default("")
  owner            String
  priority         String    @default("Medium")
  status           String    @default("Open")
  dueDate          DateTime?
  completionDate   DateTime?
  progress         Int       @default(0)
  verification     String    @default("")
  reviewerComments String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  gapId            String
  gap              Gap       @relation(fields: [gapId], references: [id])
}

// ============================================
// AUDIT
// ============================================

model AuditPlan {
  id              String      @id @default(cuid())
  planCode        String      @unique
  name            String
  type            String      @default("Regular")
  objective       String      @default("")
  description     String      @default("")
  plannedStart    DateTime?
  plannedEnd      DateTime?
  owner           String      @default("")
  leadAuditor     String      @default("")
  auditors        String      @default("[]")
  auditee         String      @default("")
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  frameworkId     String?
  priority        String      @default("Medium")
  status          String      @default("Draft")
  originalAuditId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  audits          Audit[]
}

model Audit {
  id                String              @id @default(cuid())
  auditCode         String              @unique
  planId            String?
  plan              AuditPlan?          @relation(fields: [planId], references: [id])
  name              String
  type              String              @default("Regular")
  objective         String              @default("")
  owner             String              @default("")
  leadAuditor       String              @default("")
  team              String              @default("[]")
  auditee           String              @default("")
  departmentId      String?
  department        Department?         @relation(fields: [departmentId], references: [id])
  frameworkId       String?
  startDate         DateTime?
  endDate           DateTime?
  status            String              @default("Planned")
  overallResult     String              @default("NotConclusive")
  followUpOfAuditId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  scope             AuditScope?
  checklistItems    ChecklistItem[]
  evidenceRequests  EvidenceRequest[]
  findings          Finding[]
  correctiveActions CorrectiveAction[]
  historyEvents     AuditHistoryEvent[]
}

model AuditScope {
  id             String @id @default(cuid())
  auditId        String @unique
  audit          Audit  @relation(fields: [auditId], references: [id])
  organization   String @default("")
  department     String @default("")
  businessUnit   String @default("")
  location       String @default("")
  assetIds       String @default("[]")
  frameworkIds   String @default("[]")
  requirementIds String @default("[]")
  controlIds     String @default("[]")
  policyIds      String @default("[]")
}

model ChecklistItem {
  id            String    @id @default(cuid())
  auditId       String
  audit         Audit     @relation(fields: [auditId], references: [id])
  requirementId String?
  controlId     String?
  testObjective String    @default("")
  testProcedure String    @default("")
  auditor       String    @default("")
  testDate      DateTime?
  result        String    @default("NotTested")
  comment       String    @default("")
  reviewStatus  String    @default("Pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EvidenceRequest {
  id               String    @id @default(cuid())
  auditId          String
  audit            Audit     @relation(fields: [auditId], references: [id])
  requirementId    String?
  controlId        String?
  description      String    @default("")
  evidenceType     String    @default("")
  requestedFrom    String    @default("")
  requestedBy      String    @default("")
  requestDate      DateTime  @default(now())
  dueDate          DateTime?
  status           String    @default("Requested")
  evidenceName     String    @default("")
  reviewer         String    @default("")
  reviewerComments String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Finding {
  id                String             @id @default(cuid())
  findingCode       String             @unique
  auditId           String
  audit             Audit              @relation(fields: [auditId], references: [id])
  checklistItemId   String?            @unique
  requirementId     String?
  controlId         String?
  description       String             @default("")
  evidenceRequestId String?
  rootCause         String             @default("")
  impact            String             @default("")
  riskId            String?
  risk              Risk?              @relation(fields: [riskId], references: [id])
  severity          String             @default("Medium")
  recommendation    String             @default("")
  owner             String             @default("")
  dueDate           DateTime?
  status            String             @default("Open")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  correctiveActions CorrectiveAction[]
  evidence          Evidence[]
}

model CorrectiveAction {
  id               String    @id @default(cuid())
  actionCode       String    @unique
  findingId        String
  finding          Finding   @relation(fields: [findingId], references: [id])
  auditId          String
  audit            Audit     @relation(fields: [auditId], references: [id])
  requirementId    String?
  controlId        String?
  description      String    @default("")
  owner            String    @default("")
  priority         String    @default("Medium")
  dueDate          DateTime?
  status           String    @default("Open")
  progress         Int       @default(0)
  completionDate   DateTime?
  verification     String    @default("")
  reviewerComments String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AuditHistoryEvent {
  id       String   @id @default(cuid())
  auditId  String
  audit    Audit    @relation(fields: [auditId], references: [id])
  user     String
  action   String
  when     DateTime @default(now())
  prev     String?
  next     String?
  metadata String   @default("{}")
}

// ============================================
// ASSETS
// ============================================

model Asset {
  id          String   @id @default(cuid())
  assetCode   String   @unique
  name        String
  description String   @default("")
  type        String   @default("")
  owner       String   @default("")
  location    String   @default("")
  criticality String   @default("Medium")
  status      String   @default("Active")
  domainId    String?
  domain      Domain?  @relation(fields: [domainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// CROSS-MODULE AUDIT LOG (Hash-chained)
// ============================================

model AuditLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  actorUserId       String?
  actor             User?    @relation(fields: [actorUserId], references: [id])
  actorUsername     String
  actorRole         String
  actorRoleAtTime   String
  action            String
  entityType        String
  entityId          String?
  fromState         String?
  toState           String?
  reason            String?
  metadata          String   @default("{}")
  ipAddress         String?
  previousEntryHash String?
  entryHash         String   @default("")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([timestamp])
}

// ============================================
// SoD RULES (Configurable)
// ============================================

model SoDRule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @default("")
  action      String
  constraint  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  type              String
  title             String
  message           String
  channel           String   @default("inapp")
  severity          String   @default("info")
  isRead            Boolean  @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  riskId            String?
  risk              Risk?    @relation(fields: [riskId], references: [id])
  createdAt         DateTime @default(now())

  @@index([userId, isRead])
}

// ============================================
// REPORTS
// ============================================

model GeneratedReport {
  id          String   @id @default(cuid())
  reportCode  String   @unique
  name        String
  type        String
  format      String
  generatedBy String
  generatedAt DateTime @default(now())
  parameters  String   @default("{}")
  filePath    String?
  fileHash    String?
  status      String   @default("Generated")
}
