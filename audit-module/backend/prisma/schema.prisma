generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & RBAC
// ============================================

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  fullName  String
  password  String
  role      String   @default("Viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// REFERENCE TABLES (from other modules)
// ============================================

model Framework {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        String   @default("Standard")
  version     String   @default("")
  issuer      String   @default("")
  description String   @default("")
}

model Requirement {
  id              String   @id @default(uuid())
  code            String   @unique
  title           String
  description     String   @default("")
  frameworkId     String
  category        String   @default("")
  mappedControls  String   @default("[]")
  relatedPolicies String   @default("[]")
}

model Control {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String   @default("")
  framework   String   @default("")
  domain      String   @default("")
}

model Risk {
  id          String   @id @default(uuid())
  riskCode    String   @unique
  title       String
  description String   @default("")
  level       String   @default("Medium")
}

model Policy {
  id          String   @id @default(uuid())
  policyCode  String   @unique
  title       String
  description String   @default("")
  status      String   @default("Draft")
}

model Asset {
  id          String   @id @default(uuid())
  assetCode   String   @unique
  name        String
  description String   @default("")
  type        String   @default("")
}

model Auditor {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  department String   @default("")
}

// ============================================
// AUDIT PLANS
// ============================================

model AuditPlan {
  id              String    @id @default(uuid())
  planCode        String    @unique
  name            String
  type            String    @default("Regular")
  objective       String    @default("")
  description     String    @default("")
  plannedStart    DateTime?
  plannedEnd      DateTime?
  owner           String    @default("")
  leadAuditor     String    @default("")
  auditors        String    @default("[]")
  auditee         String    @default("")
  department      String    @default("")
  frameworkId     String?
  priority        String    @default("Medium")
  status          String    @default("Draft")
  originalAuditId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  audits          Audit[]   @relation("PlanToAudit")
}

// ============================================
// AUDITS
// ============================================

model Audit {
  id                String    @id @default(uuid())
  auditCode         String    @unique
  planId            String?
  plan              AuditPlan? @relation("PlanToAudit", fields: [planId], references: [id])
  name              String
  type              String    @default("Regular")
  objective         String    @default("")
  owner             String    @default("")
  leadAuditor       String    @default("")
  team              String    @default("[]")
  auditee           String    @default("")
  department        String    @default("")
  frameworkId       String?
  startDate         DateTime?
  endDate           DateTime?
  status            String    @default("Planned")
  overallResult     String    @default("Not Conclusive")
  followUpOfAuditId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scope               AuditScope?      @relation("AuditToScope")
  checklistItems      ChecklistItem[]
  evidenceRequests    EvidenceRequest[]
  findings            Finding[]
  correctiveActions   CorrectiveAction[]
  historyEvents       AuditHistoryEvent[]
}

// ============================================
// AUDIT SCOPE
// ============================================

model AuditScope {
  id              String   @id @default(uuid())
  auditId         String   @unique
  audit           Audit    @relation("AuditToScope", fields: [auditId], references: [id])
  organization    String   @default("")
  department      String   @default("")
  businessUnit    String   @default("")
  location        String   @default("")
  assetIds        String   @default("[]")
  frameworkIds    String   @default("[]")
  requirementIds  String   @default("[]")
  controlIds      String   @default("[]")
  policyIds       String   @default("[]")
}

// ============================================
// CHECKLIST ITEMS
// ============================================

model ChecklistItem {
  id                 String    @id @default(uuid())
  auditId            String
  requirementId      String?
  controlId          String?
  testObjective      String    @default("")
  testProcedure      String    @default("")
  auditor            String    @default("")
  testDate           DateTime?
  result             String    @default("NotTested")
  comment            String    @default("")
  reviewStatus       String    @default("Pending")
  evidenceRequestIds String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  audit              Audit     @relation(fields: [auditId], references: [id])
  finding            Finding?
}

// ============================================
// EVIDENCE REQUESTS
// ============================================

model EvidenceRequest {
  id               String    @id @default(uuid())
  auditId          String
  requirementId    String?
  controlId        String?
  description      String    @default("")
  evidenceType     String    @default("")
  requestedFrom    String    @default("")
  requestedBy      String    @default("")
  requestDate      DateTime  @default(now())
  dueDate          DateTime?
  status           String    @default("Requested")
  evidenceName     String    @default("")
  reviewer         String    @default("")
  reviewerComments String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  audit            Audit     @relation(fields: [auditId], references: [id])
}

// ============================================
// FINDINGS
// ============================================

model Finding {
  id                String    @id @default(uuid())
  findingCode       String    @unique
  auditId           String
  checklistItemId   String?   @unique
  requirementId     String?
  controlId         String?
  description       String    @default("")
  evidenceRequestId String?
  rootCause         String    @default("")
  impact            String    @default("")
  riskId            String?
  severity          String    @default("Medium")
  recommendation    String    @default("")
  owner             String    @default("")
  dueDate           DateTime?
  status            String    @default("Open")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  audit             Audit     @relation(fields: [auditId], references: [id])
  checklistItem     ChecklistItem? @relation(fields: [checklistItemId], references: [id])
  correctiveActions CorrectiveAction[]
}

// ============================================
// CORRECTIVE ACTIONS
// ============================================

model CorrectiveAction {
  id               String    @id @default(uuid())
  actionCode       String    @unique
  findingId        String
  auditId          String
  requirementId    String?
  controlId        String?
  description      String    @default("")
  owner            String    @default("")
  priority         String    @default("Medium")
  dueDate          DateTime?
  status           String    @default("Open")
  progress         Int       @default(0)
  completionDate   DateTime?
  verification     String    @default("")
  reviewerComments String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  audit            Audit     @relation(fields: [auditId], references: [id])
  finding          Finding   @relation(fields: [findingId], references: [id])
}

// ============================================
// AUDIT HISTORY (append-only)
// ============================================

model AuditHistoryEvent {
  id        String   @id @default(uuid())
  auditId   String
  user      String
  action    String
  when      DateTime @default(now())
  prev      String?
  next      String?
  metadata  String   @default("{}")

  audit     Audit    @relation(fields: [auditId], references: [id])
}
